# =============================================================================
# deploy/edt.env.exemple — modèle de /etc/edt/edt.env (environnement de production).
#
# installer-serveur.sh copie ce modèle vers /etc/edt/edt.env s'il n'existe pas,
# puis ne l'écrase plus jamais : c'est le fichier du serveur qui fait foi.
# Pour le modifier :  sudo nano /etc/edt/edt.env  puis  sudo systemctl restart edt
#
# Ce fichier est lu par systemd (EnvironmentFile=) ET par deployer-distant.sh.
# Format strict : une variable par ligne, NOM=valeur, sans espace autour du
# « = », sans guillemets. Les lignes qui commencent par # sont ignorées.
# Aucun secret n'est nécessaire aujourd'hui ; s'il en faut un jour, il ira
# dans ce fichier du serveur (lisible par root et le groupe edt seulement),
# jamais dans le dépôt.
# =============================================================================

# Base SQLite. Quatre barres obliques = chemin absolu. Le fichier doit rester
# dans /var/lib/edt : c'est le seul dossier de données où le service a le droit
# d'écrire (ReadWritePaths dans edt.service).
EDT_DB_URL=sqlite:////var/lib/edt/edt.db

# Dossier des journaux de l'application (edt.log et generations/).
EDT_LOG_DIR=/var/log/edt

# Adresse et port d'écoute. edt.service passe déjà --host 127.0.0.1 --port 8000
# à uvicorn et nginx relaie vers 127.0.0.1:8000 : garder les trois cohérents.
EDT_HOST=127.0.0.1
EDT_PORT=8000

# Environnement d'exécution.
EDT_ENV=prod

# Niveau de journalisation : DEBUG, INFO, WARNING ou ERROR.
EDT_LOG_LEVEL=INFO

# Fuseau horaire du processus (un VPS est en général réglé en UTC) : les heures
# des journaux de l'application et « maintenant » sont en heure de Paris.
TZ=Europe/Paris
