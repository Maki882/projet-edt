# =============================================================================
# deploy/edt.env.exemple — modèle de /etc/edt/edt.env (environnement de production).
#
# installer-serveur.sh le copie vers /etc/edt/edt.env s'il n'existe pas, puis ne
# l'écrase jamais : c'est le fichier du serveur qui fait foi. Pour le modifier :
#   sudo nano /etc/edt/edt.env   puis   sudo systemctl restart edt
# Lu uniquement par systemd (service, lanceur « sudo edt », déploiements) :
# une variable par ligne, NOM=valeur ; lignes en # ignorées. Ce fichier ne
# contient aucun secret : installer-serveur.sh l'affiche (différences avec ce
# modèle) à chaque passage.
# =============================================================================

# Base SQLite : quatre barres obliques = chemin absolu, dans /var/lib/edt (seul
# dossier de données où le service peut écrire : ReadWritePaths de edt.service).
EDT_DB_URL=sqlite:////var/lib/edt/edt.db

# Journaux de l'application (edt.log et generations/).
EDT_LOG_DIR=/var/log/edt

# Adresse et port : edt.service passe déjà --host 127.0.0.1 --port 8000 à
# uvicorn et nginx relaie vers 127.0.0.1:8000 ; garder les trois cohérents.
EDT_HOST=127.0.0.1
EDT_PORT=8000

EDT_ENV=prod

# DEBUG, INFO, WARNING ou ERROR.
EDT_LOG_LEVEL=INFO

# Tests lancés depuis l'application (onglets « Tests unitaires » et « Tests
# d'intégration », commande « sudo edt tests ») : durée maximale d'une
# exécution en secondes, et « non » pour désactiver les boutons de lancement
# (les derniers résultats restent consultables).
#EDT_TESTS_DUREE_MAX_S=900
#EDT_TESTS_LANCEMENT=oui

# Heures des journaux et « maintenant » en heure de Paris (l'horloge d'un
# serveur est souvent réglée en UTC).
TZ=Europe/Paris

# --- Assistant conversationnel -----------------------------------------------
# La clé de l'API ne va PAS dans ce fichier (il est affiché par
# installer-serveur.sh) : elle est installée dans /etc/edt/assistant.env par
# deploy/installer-cle-assistant.sh. Sans clé, l'assistant est « non
# configuré » et le reste de l'application fonctionne.
# Réglages facultatifs, ici avec leur valeur par défaut : retirer le « # » pour
# en changer un, puis « sudo systemctl restart edt ». Une valeur invalide rend
# l'assistant indisponible (message dans le journal), jamais l'application.
# Assistant actif (oui) ou coupé sans retirer la clé (non).
#EDT_ASSISTANT_ACTIF=oui
# Modèle et niveau d'effort (low, medium, high, xhigh, max).
#EDT_ASSISTANT_MODELE=claude-opus-5-5
#EDT_ASSISTANT_EFFORT=low
# Jetons de sortie par appel au modèle, appels au modèle par échange.
#EDT_ASSISTANT_JETONS_SORTIE_MAX=4096
#EDT_ASSISTANT_APPELS_MAX=5
# Échéance d'un échange et d'un appel, en secondes.
#EDT_ASSISTANT_DELAI_S=90
#EDT_ASSISTANT_DELAI_APPEL_S=40
# Caractères par message, messages par conversation, jetons d'entrée par appel.
#EDT_ASSISTANT_LONGUEUR_MAX=800
#EDT_ASSISTANT_MESSAGES_PAR_CONVERSATION=10
#EDT_ASSISTANT_CONTEXTE_MAX=40000
# Messages par adresse IP et par jour, messages par jour pour tout le site.
#EDT_ASSISTANT_MESSAGES_PAR_ADRESSE=20
#EDT_ASSISTANT_MESSAGES_PAR_JOUR=100
# Budget par jour pour tout le site, en dollars (coût estimé).
#EDT_ASSISTANT_BUDGET_JOUR=2.00
# Échanges en même temps ; conversations gardées en mémoire et leur durée de vie (minutes).
#EDT_ASSISTANT_SIMULTANES=2
#EDT_ASSISTANT_CONVERSATIONS_MAX=200
#EDT_ASSISTANT_EXPIRATION_MIN=30
# oui : textes des messages dans le journal au niveau DEBUG (débogage local seulement).
#EDT_ASSISTANT_JOURNAL_CONTENU=non
