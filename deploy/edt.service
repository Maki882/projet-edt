# =============================================================================
# deploy/edt.service — unité systemd de l'application EDT, installée par
# installer-serveur.sh dans /etc/systemd/system/edt.service (à relancer après
# toute modification ici). Sur le serveur : sudo systemctl status|restart edt,
# sudo journalctl -u edt -n 100.
# =============================================================================

[Unit]
Description=EDT - générateur d'emplois du temps (FastAPI, uvicorn)
Documentation=file:/opt/edt/courant/code/docs/deploiement.md
After=network.target
# Au-delà de 5 démarrages en 2 minutes, systemd abandonne (état « failed ») :
# nginx affiche la page 502. deployer.sh remet ce compteur à zéro (reset-failed).
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
# « exec » : systemctl start échoue si le programme ne peut pas être lancé.
Type=exec
User=edt
Group=edt
# /opt/edt/courant : lien vers la version en service (géré par deployer.sh).
WorkingDirectory=/opt/edt/courant/code
EnvironmentFile=/etc/edt/edt.env
# Clé de l'assistant, facultative (« - » : fichier absent toléré) ; écrite par
# deploy/installer-cle-assistant.sh, jamais dans edt.env.
EnvironmentFile=-/etc/edt/assistant.env
Environment=PYTHONUNBUFFERED=1
# Un seul processus (le calcul tourne dans un thread et son état est en
# mémoire), sans rechargement automatique. --proxy-headers : les en-têtes
# X-Forwarded-* de nginx (127.0.0.1 seulement) donnent le bon schéma et la
# vraie adresse du client. --no-access-log : l'application journalise déjà
# chaque requête, avec son identifiant.
ExecStart=/opt/edt/courant/venv/bin/python -m uvicorn edt.web.asgi:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-access-log
# Préparation : une première page demandée dès le démarrage, pour que le
# premier visiteur n'attende pas le chargement initial (gabarits, base). Échec
# toléré (« - ») et durée bornée à 50 s, sous TimeoutStartSec : elle ne peut
# ni faire échouer ni bloquer le démarrage.
ExecStartPost=-/usr/bin/curl --silent --output /dev/null --max-time 20 --retry 30 --retry-delay 1 --retry-max-time 30 --retry-connrefused http://127.0.0.1:8000/
TimeoutStartSec=90
Restart=on-failure
RestartSec=3
# Arrêt : 20 s de délai de grâce, puis arrêt forcé (un calcul en cours est perdu).
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal
SyslogIdentifier=edt
UMask=0027
# Au-delà de 3 Go, le service est tué (« oom » dans le journal) et redémarré,
# plutôt que de faire tomber tout le serveur. À adapter à la mémoire du
# serveur : laisser au moins 0,5 Go au système, à nginx et à SSH.
MemoryMax=3G

# --- Durcissement ------------------------------------------------------------
# Système de fichiers en lecture seule sauf la base et les journaux ; /home,
# /root, /tmp des autres, périphériques, noyau et cgroups hors d'atteinte ;
# aucun gain de privilège ni capacité root (le port 8000 n'en demande pas).
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/edt /var/log/edt
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
