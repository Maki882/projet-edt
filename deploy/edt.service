# =============================================================================
# deploy/edt.service — unité systemd de l'application EDT.
# Installée par deploy/installer-serveur.sh dans /etc/systemd/system/edt.service.
# Après modification ici : relancer installer-serveur.sh (il recharge systemd et
# redémarre le service si l'unité a changé).
#
# Commandes utiles (sur le serveur) :
#   sudo systemctl status edt          état
#   sudo systemctl restart edt         redémarrage
#   sudo journalctl -u edt -n 100      100 dernières lignes de journal
# =============================================================================

[Unit]
Description=EDT - générateur d'emplois du temps (FastAPI, uvicorn)
Documentation=file:/opt/edt/courant/code/docs/deploiement.md
After=network.target
# Au-delà de 5 échecs de démarrage en 2 minutes, systemd abandonne (état
# « failed ») au lieu de boucler : nginx affiche alors la page 502.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
# « exec » : systemctl start échoue si le programme ne peut pas être lancé.
Type=exec
User=edt
Group=edt
# /opt/edt/courant est un lien vers la version en service (géré par deployer.sh).
WorkingDirectory=/opt/edt/courant/code
EnvironmentFile=/etc/edt/edt.env
# Sortie Python non tamponnée : les messages arrivent tout de suite dans le journal.
Environment=PYTHONUNBUFFERED=1
# Un seul processus (le calcul tourne dans un thread de ce processus et son
# état est gardé en mémoire), pas de rechargement automatique. Derrière nginx :
# --proxy-headers fait confiance aux en-têtes X-Forwarded-* envoyés par
# 127.0.0.1 seulement (bon schéma http/https et vraie adresse du client).
ExecStart=/opt/edt/courant/venv/bin/python -m uvicorn edt.web.asgi:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=3
# Arrêt : 20 s de délai de grâce, puis arrêt forcé (un calcul en cours est perdu).
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal
SyslogIdentifier=edt
UMask=0027

# Mémoire : au-delà de 3 Go (sur 3,7 Go), le service est tué et redémarré
# plutôt que de faire tomber tout le serveur. Visible dans le journal (« oom »).
MemoryMax=3G

# --- Durcissement ------------------------------------------------------------
# Aucun gain de privilège possible (sudo, setuid...).
NoNewPrivileges=true
# Tout le système de fichiers est en lecture seule pour le service, sauf :
ProtectSystem=strict
ReadWritePaths=/var/lib/edt /var/log/edt
# Les dossiers personnels (/home, /root) sont invisibles.
ProtectHome=true
# /tmp privé au service.
PrivateTmp=true
# Pas d'accès aux périphériques matériels.
PrivateDevices=true
# Pas de modification du noyau, de ses modules ni des cgroups.
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
# Aucune capacité root (le port 8000 n'en demande pas).
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
