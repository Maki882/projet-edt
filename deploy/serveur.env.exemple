# =============================================================================
# deploy/serveur.env.exemple — modèle des paramètres d'une installation.
#
# Copier ce fichier en deploy/serveur.env (ignoré par git) et remplacer les
# valeurs d'exemple par celles du serveur :
#   cp deploy/serveur.env.exemple deploy/serveur.env
# Lu par les scripts du poste (deployer.sh, etat.sh, journaux.sh) et, une fois
# le dossier deploy/ copié sur le serveur, par installer-serveur.sh et
# activer-https.sh. Une variable d'environnement du même nom l'emporte.
# Format : NOM=valeur, une par ligne (détail dans deploy/configuration.sh).
# Ce fichier ne contient aucun secret : la clé SSH reste dans ~/.ssh, seul son
# chemin figure ici.
# =============================================================================

# Adresse du serveur (adresse IP ou nom).
EDT_SSH_HOTE=203.0.113.10

# Compte SSH du serveur, qui dispose de sudo sans mot de passe.
EDT_SSH_UTILISATEUR=ubuntu

# Clé privée SSH dédiée à ce serveur (chemin sur le poste).
EDT_SSH_CLE=~/.ssh/cle_edt

# Nom de domaine public de l'application (enregistrement DNS de type A vers le serveur).
EDT_DOMAINE=edt.example.org

# Facultatifs, pour activer-https.sh :
# adresse de contact du compte Let's Encrypt (vide = inscription sans adresse) ;
#EDT_CERTBOT_EMAIL=exploitation@example.org
# adresse IPv4 publique du serveur, si la détection automatique ne convient pas.
#EDT_IP_PUBLIQUE=203.0.113.10
