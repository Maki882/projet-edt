# Fichiers de verrou Office (document ouvert)
~$*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Secrets et config locale
.env
.env.*
!.env.example

# Éditeurs et OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Données et sorties générées (jamais dans le dépôt)
data/
logs/
*.db
*.sqlite*
*.log
output/

# Paramètres de l'installation (adresse du serveur, domaine, clé SSH) : modèle deploy/serveur.env.exemple
deploy/serveur.env
